{
  "name": "dsh-turbo-mode",
  "version": "0.1.0",
  "description": "Server-side fast mode for DeepSeek Harness: requests an upstream priority service tier where the provider supports one, measures whether it really is faster, and never lowers reasoning effort or output length.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "fast-mode",
    "service-tier",
    "latency",
    "observability"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "license": "MIT",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iambubu0523/dsh-turbo.git"
  },
  "homepage": "https://github.com/iambubu0523/dsh-turbo#readme",
  "bugs": {
    "url": "https://github.com/iambubu0523/dsh-turbo/issues"
  },
  "author": "dsh-turbo-mode contributors",
  "publishConfig": {
    "access": "public"
  }
}
